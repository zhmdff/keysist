<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Keysist.Views.NewMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Keysist.Views">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="New Mapping" />

        <TextBlock
            x:Name="StepIndicator"
            Grid.Row="1"
            Margin="0,0,0,16"
            Opacity="0.7"
            Text="Step 1 of 3 — Trigger" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
            <StackPanel MaxWidth="640" Spacing="16" HorizontalAlignment="Left">
                <StackPanel x:Name="TriggerStepPanel" Spacing="16">
                    <TextBlock
                        Opacity="0.7"
                        Text="Capture the key or keys that should trigger this mapping."
                        TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Device filter:" />
                        <ComboBox x:Name="DeviceFilterCombo" MinWidth="240" SelectionChanged="DeviceFilterCombo_SelectionChanged" />
                    </StackPanel>
                    <local:CapturePanel x:Name="TriggerCapture" />
                </StackPanel>

                <StackPanel x:Name="ActionStepPanel" Spacing="16" Visibility="Collapsed">
                    <RadioButtons
                        x:Name="ActionTypeRadios"
                        SelectedIndex="0"
                        SelectionChanged="ActionTypeRadios_SelectionChanged">
                        <RadioButton x:Name="SendKeysRadio" Content="Send keys" />
                        <RadioButton x:Name="PasteRadio" Content="Paste text" />
                        <RadioButton x:Name="LaunchRadio" Content="Launch" />
                    </RadioButtons>
                    <StackPanel x:Name="SendKeysPanel" Spacing="8">
                        <TextBlock
                            Opacity="0.7"
                            Text="Capture the keys to send when the trigger fires."
                            TextWrapping="WrapWholeWords" />
                        <local:CapturePanel x:Name="ActionCapture" />
                    </StackPanel>
                    <StackPanel x:Name="PastePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Text" />
                        <TextBox
                            x:Name="PasteTextBox"
                            AcceptsReturn="True"
                            MinHeight="80"
                            PlaceholderText="Text to paste"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="Method:" />
                            <ComboBox x:Name="PasteMethodCombo" MinWidth="120">
                                <ComboBoxItem Content="type" />
                                <ComboBoxItem Content="clipboard" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="LaunchPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Path" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PathBox"
                                PlaceholderText="Path to .exe, .bat, .ps1, …" />
                            <Button
                                Grid.Column="1"
                                Click="BrowsePath_Click"
                                Content="Browse…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="96" />
                        </Grid>
                        <TextBlock Text="Arguments" />
                        <TextBox x:Name="ArgsBox" PlaceholderText="Arguments (optional)" />
                        <TextBlock Text="Working directory" />
                        <TextBox x:Name="WorkDirBox" PlaceholderText="Working directory (optional)" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ReviewStepPanel" Spacing="16" Visibility="Collapsed">
                    <TextBlock Opacity="0.7" Text="Review your mapping before saving." />
                    <TextBlock x:Name="ReviewTrigger" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="ReviewAction" Opacity="0.8" TextWrapping="WrapWholeWords" />
                    <ToggleSwitch
                        x:Name="SwallowToggle"
                        Header="Remove original key"
                        OffContent="Keep"
                        OnContent="Block" />
                    <TextBlock
                        Opacity="0.6"
                        FontSize="12"
                        Text="When on, the original keystroke is blocked so only your remapped action runs."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Style="{StaticResource WizardFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Content="Back"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Click="Cancel_Click"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
            <Button
                x:Name="NextButton"
                Grid.Column="1"
                Click="NextButton_Click"
                Content="Next"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
