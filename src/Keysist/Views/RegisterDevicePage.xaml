<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Keysist.Views.RegisterDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Keysist.Views">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Register Device" />

        <StackPanel
            Grid.Row="1"
            MaxWidth="480"
            Spacing="16"
            VerticalAlignment="Top">
            <TextBlock
                Opacity="0.7"
                Text="Capture a key on the device you want to register, then give it a name."
                TextWrapping="WrapWholeWords" />

            <local:CapturePanel x:Name="CapturePanel" />

            <StackPanel Spacing="4">
                <TextBlock Text="Device name" />
                <TextBox
                    x:Name="NameBox"
                    PlaceholderText="e.g. Numpad, Stream Deck"
                    Width="320" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="Save_Click"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Click="Back_Click" Content="Cancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
