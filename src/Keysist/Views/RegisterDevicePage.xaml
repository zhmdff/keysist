<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Keysist.Views.RegisterDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Keysist.Views">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Register Device" />

        <StackPanel
            Grid.Row="1"
            MaxWidth="640"
            Spacing="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <TextBlock
                Opacity="0.7"
                Text="Capture a key on the device you want to register, then give it a name."
                TextWrapping="WrapWholeWords" />

            <local:CapturePanel x:Name="CapturePanel" />

            <StackPanel Spacing="4" HorizontalAlignment="Left">
                <TextBlock Text="Device name" />
                <TextBox
                    x:Name="NameBox"
                    PlaceholderText="e.g. Numpad, Stream Deck"
                    MinWidth="320"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Style="{StaticResource WizardFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Click="Back_Click"
                Content="Cancel"
                HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Grid.Column="1"
                Click="Save_Click"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
