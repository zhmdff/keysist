<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Keysist.Views.CapturePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="CaptureBorder"
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Mode:" />
                <ComboBox
                    x:Name="ModeCombo"
                    MinWidth="120"
                    SelectionChanged="ModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Key" />
                    <ComboBoxItem Content="Chord" />
                    <ComboBoxItem Content="Sequence" />
                </ComboBox>
                <Button
                    x:Name="StartButton"
                    Click="StartButton_Click"
                    Content="Start"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="StopButton"
                    Click="StopButton_Click"
                    Content="Stop"
                    IsEnabled="False" />
            </StackPanel>
            <TextBlock
                x:Name="ResultText"
                Text="Press Start, then input on the target device."
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Border>
</UserControl>
