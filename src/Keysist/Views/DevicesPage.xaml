<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Keysist.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Keysist.Views">
    <Grid Padding="24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Devices" />

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Left">
            <Button
                Click="RegisterDevice_Click"
                Content="Register Device"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Click="NewMapping_Click"
                Content="New Mapping"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="2" HorizontalAlignment="Stretch">
            <ScrollViewer HorizontalAlignment="Stretch">
                <StackPanel x:Name="DevicesHost" Spacing="16" HorizontalAlignment="Stretch" />
            </ScrollViewer>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="40"
                    Foreground="{StaticResource KeysistAccentBrush}"
                    Glyph="&#xE7F8;"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Style="{StaticResource EmptyStateTitleStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Text="No devices yet" />
                <TextBlock
                    Style="{StaticResource EmptyStateBodyStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Text="Register a keyboard or keypad, then add mappings for its keys." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
