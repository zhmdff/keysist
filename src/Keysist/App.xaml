<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Keysist.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Light Windows-style neutrals -->
            <Color x:Key="KeysistAccentColor">#1B1B1B</Color>
            <Color x:Key="KeysistBgColor">#F3F3F3</Color>
            <Color x:Key="KeysistSurfaceColor">#FFFFFF</Color>
            <Color x:Key="KeysistBorderColor">#D1D1D1</Color>
            <Color x:Key="KeysistMutedColor">#5C5C5C</Color>
            <Color x:Key="KeysistTextColor">#1B1B1B</Color>

            <SolidColorBrush x:Key="KeysistAccentBrush" Color="{StaticResource KeysistAccentColor}" />
            <SolidColorBrush x:Key="KeysistBgBrush" Color="{StaticResource KeysistBgColor}" />
            <SolidColorBrush x:Key="KeysistSurfaceBrush" Color="{StaticResource KeysistSurfaceColor}" />
            <SolidColorBrush x:Key="KeysistBorderBrush" Color="{StaticResource KeysistBorderColor}" />
            <SolidColorBrush x:Key="KeysistMutedBrush" Color="{StaticResource KeysistMutedColor}" />
            <SolidColorBrush x:Key="KeysistTextBrush" Color="{StaticResource KeysistTextColor}" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="{StaticResource KeysistAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource KeysistAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="{StaticResource KeysistSurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource KeysistTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource KeysistBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource KeysistTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource KeysistTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <Style x:Key="EmptyStateBodyStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KeysistMutedBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="Margin" Value="0,8,0,16" />
            </Style>

            <Style x:Key="MappingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource KeysistSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource KeysistBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="WizardFooterStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <SolidColorBrush x:Key="KeysistDangerBrush" Color="#C42B1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
